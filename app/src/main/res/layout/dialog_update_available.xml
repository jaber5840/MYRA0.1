<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_update_dialog"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="24dp">

    <!-- TOP ROW: BADGE + TOP-RIGHT CANCEL (X) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/updateHeaderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="SYSTEM UPDATE"
            android:textColor="#FF1744"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <ImageButton
            android:id="@+id/closeUpdateDialogBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel update"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <!-- CONTENT CONTAINER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/updateTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="New Version Ready"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updateVersionPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_version_badge"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:text="v0.1  →  v0.2"
            android:textColor="#FF80AB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updateNotesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxLines="5"
            android:ellipsize="end"
            android:text="Latest improvements, faster voice response, and stability upgrades are ready."
            android:textColor="#CCCCCC"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/downloadUpdateBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_save_button"
            android:letterSpacing="0.12"
            android:text="DOWNLOAD"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
